# --- Data ---------------------------------------------------------------
# Images and lung masks (~800 MB) are fetched from Kaggle, never committed.
# Split manifests ARE committed so the exact partition is reproducible.
data/*
!data/splits/
data/splits/*
!data/splits/*.csv
!data/splits/.gitkeep

# --- Model artefacts ----------------------------------------------------
checkpoints/
*.h5
*.keras
*.weights.h5
*.pb
saved_model/

# --- Generated reports --------------------------------------------------
# Figures are regenerated by the notebooks; only committed for the README.
reports/figures/*
!reports/figures/.gitkeep

# --- Credentials --------------------------------------------------------
kaggle.json
.env

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
.pytest_cache/

# --- OS -----------------------------------------------------------------
.DS_Store
